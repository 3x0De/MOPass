{
  "name": "mopass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "3x0De <3x0De@github.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:server": "esbuild server.js --bundle --platform=node --format=cjs --outfile=dist-server/server.js",
    "build": "vue-tsc && vite build && npm run build:server",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.mopass.app",
    "productName": "MOPass",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-server/server.js",
        "to": "server.js"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/logos/mini.png"
    }
  },
  "dependencies": {
    "@remixicon/vue": "^4.9.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.5"
  }
}
